---
import "../styles/global.css";
import Header from "../components/Header";
import Footer from "../components/Footer";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Portfolio of Muhamad Wahyudin" } = Astro.props;

const navItems = [
    { label: "Home", href: "/" },
    { label: "Projects", href: "/projects" },
    { label: "Blog", href: "/blog" },
    { label: "Work", href: "/work" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://hyuwah.github.io/og-image.png" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={Astro.url.href} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://hyuwah.github.io/og-image.png" />

        <!-- Canonical -->
        <link rel="canonical" href={Astro.url.href} />

        <!-- JSON-LD Person Schema -->
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Person",
          "name": "Muhamad Wahyudin",
          "url": "https://hyuwah.github.io",
          "jobTitle": "Software Engineer",
          "sameAs": [
            "https://github.com/hyuwah",
            "https://www.linkedin.com/in/hyuwah/",
            "https://dev.to/hyuwah"
          ]
        })} />

        <!-- TODO: Create public/og-image.png (1200x630 recommended) for social sharing previews -->

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        {/* Prevent flash of wrong theme */}
        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (
                    typeof window !== "undefined" &&
                    window.matchMedia("(prefers-color-scheme: dark)").matches
                ) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }

            window.addEventListener("storage", (event) => {
                if (event.key === "theme") {
                    const newTheme = event.newValue;
                    if (newTheme === "dark") {
                        document.documentElement.classList.add("dark");
                    } else {
                        document.documentElement.classList.remove("dark");
                    }
                }
            });
        </script>

        <style is:global>
            body {
                font-family:
                    "Inter",
                    system-ui,
                    -apple-system,
                    sans-serif;
            }

            /* Dark mode transitions */
            html.dark body {
                background-color: #0f172a;
                color: #f1f5f9;
            }

            /* Smooth transitions for theme changes */
            body,
            .bg-white,
            .bg-gray-50,
            .bg-gray-100,
            .text-gray-900,
            .text-gray-600,
            .text-gray-500,
            .border-gray-100,
            .border-gray-200 {
                transition:
                    background-color 0.3s ease,
                    color 0.3s ease,
                    border-color 0.3s ease;
            }

            /* Dark mode overrides */
            html.dark .prose p {
                color: #cbd5e1;
            }
            html.dark .prose h1,
            html.dark .prose h2,
            html.dark .prose h3 {
                color: #f1f5f9;
            }
            html.dark .prose li {
                color: #cbd5e1;
            }
            html.dark .prose a {
                color: #60a5fa;
            }
            html.dark .prose a:hover {
                color: #93c5fd;
            }

            html.dark .prose p {
                margin-bottom: 1.25rem;
                line-height: 1.75;
            }
            html.dark .prose h1,
            html.dark .prose h2,
            html.dark .prose h3 {
                margin-top: 2rem;
                margin-bottom: 1rem;
                font-weight: 600;
            }
            html.dark .prose h1 {
                font-size: 1.875rem;
            }
            html.dark .prose h2 {
                font-size: 1.5rem;
            }
            html.dark .prose h3 {
                font-size: 1.25rem;
            }
            html.dark .prose ul {
                margin-left: 1.5rem;
                margin-bottom: 1.25rem;
                list-style-type: disc;
                padding-left: 0.5rem;
            }
            html.dark .prose ol {
                margin-left: 1.5rem;
                margin-bottom: 1.25rem;
                list-style-type: decimal;
                padding-left: 0.5rem;
                font-variant-numeric: tabular-nums;
            }
            html.dark .prose li {
                margin-bottom: 0.5rem;
                line-height: 1.75;
                padding-left: 0.25rem;
            }
            html.dark .prose ul ul {
                list-style-type: circle;
                margin-bottom: 0.25rem;
            }
            html.dark .prose ol ol {
                list-style-type: lower-alpha;
                margin-bottom: 0.25rem;
            }
            html.dark .prose li::marker {
                color: #94a3b8;
                font-size: 0.875em;
            }
            html.dark .prose a {
                color: #60a5fa;
                text-decoration: underline;
                text-decoration-color: #3b82f6;
                text-underline-offset: 2px;
            }
            html.dark .prose a:hover {
                color: #93c5fd;
                text-decoration-color: #60a5fa;
            }
            html.dark .prose code {
                background-color: #1e293b;
                color: #e2e8f0;
                padding: 0.125rem 0.375rem;
                border-radius: 0.25rem;
                font-size: 0.875em;
                font-family: ui-monospace, monospace;
            }
            html.dark .prose pre {
                background-color: #0f172a;
                color: #e2e8f0;
                padding: 1rem;
                border-radius: 0.5rem;
                overflow-x: auto;
                margin-bottom: 1.25rem;
                border: 1px solid #334155;
            }
            html.dark .prose pre code {
                background-color: transparent;
                padding: 0;
                color: inherit;
            }

            /* Dark mode table styles */
            html.dark .prose table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 1.25rem;
                font-size: 0.875rem;
                overflow-x: auto;
                display: block;
            }
            html.dark .prose thead th {
                background-color: #1e293b;
                color: #e2e8f0;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.05em;
                padding: 0.75rem 1rem;
                border-bottom: 2px solid #475569;
                text-align: left;
            }
            html.dark .prose tbody td {
                padding: 0.75rem 1rem;
                border-bottom: 1px solid #334155;
                color: #cbd5e1;
            }
            html.dark .prose tbody tr:hover {
                background-color: #1e293b;
            }
            html.dark .prose tbody tr:last-child td {
                border-bottom: none;
            }

            /* Light mode prose styles */
            .prose p {
                margin-bottom: 1.25rem;
                line-height: 1.75;
            }
            .prose h1,
            .prose h2,
            .prose h3 {
                margin-top: 2rem;
                margin-bottom: 1rem;
                font-weight: 600;
            }
            .prose h1 {
                font-size: 1.875rem;
            }
            .prose h2 {
                font-size: 1.5rem;
            }
            .prose h3 {
                font-size: 1.25rem;
            }
            .prose ul {
                margin-left: 1.5rem;
                margin-bottom: 1.25rem;
                list-style-type: disc;
                padding-left: 0.5rem;
            }
            .prose ol {
                margin-left: 1.5rem;
                margin-bottom: 1.25rem;
                list-style-type: decimal;
                padding-left: 0.5rem;
                font-variant-numeric: tabular-nums;
            }
            .prose li {
                margin-bottom: 0.5rem;
                line-height: 1.75;
                padding-left: 0.25rem;
            }
            .prose ul ul {
                list-style-type: circle;
                margin-bottom: 0.25rem;
            }
            .prose ol ol {
                list-style-type: lower-alpha;
                margin-bottom: 0.25rem;
            }
            .prose li::marker {
                color: #9ca3af;
                font-size: 0.875em;
            }
            .prose a {
                color: #2563eb;
                text-decoration: underline;
                text-decoration-color: #bfdbfe;
                text-underline-offset: 2px;
            }
            .prose a:hover {
                color: #1d4ed8;
                text-decoration-color: #2563eb;
            }
            .prose code {
                background-color: #f3f4f6;
                padding: 0.125rem 0.375rem;
                border-radius: 0.25rem;
                font-size: 0.875em;
                font-family: ui-monospace, monospace;
            }
            .prose pre {
                background-color: #1f2937;
                color: #f9fafb;
                padding: 1rem;
                border-radius: 0.5rem;
                overflow-x: auto;
                margin-bottom: 1.25rem;
            }
            .prose pre code {
                background-color: transparent;
                padding: 0;
                color: inherit;
            }

            /* Light mode table styles */
            .prose table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 1.25rem;
                font-size: 0.875rem;
                overflow-x: auto;
                display: block;
            }
            .prose thead th {
                background-color: #f9fafb;
                color: #111827;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.05em;
                padding: 0.75rem 1rem;
                border-bottom: 2px solid #d1d5db;
                text-align: left;
            }
            .prose tbody td {
                padding: 0.75rem 1rem;
                border-bottom: 1px solid #e5e7eb;
                color: #374151;
            }
            .prose tbody tr:hover {
                background-color: #f9fafb;
            }
            .prose tbody tr:last-child td {
                border-bottom: none;
            }
        </style>
    </head>
    <body
        class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 antialiased"
    >
        <div class="min-h-screen flex flex-col">
            {/* Navigation - Using React Header component */}
            <Header client:load navItems={navItems} currentPath={currentPath} />

            {/* Main Content */}
            <main class="flex-1 max-w-3xl w-full mx-auto px-6 py-12">
                <slot />
            </main>

            {/* Footer - Using React Footer component */}
            <Footer client:visible />
        </div>

        <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('visible');
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
                );

                document.querySelectorAll('.animate-on-scroll').forEach((el) => {
                    observer.observe(el);
                });
            });
        </script>
    </body>
</html>
