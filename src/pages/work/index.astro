---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Card, CardContent } from "../../components/ui/card";
import { Calendar, Link, Play } from "lucide-react";

const workItems = await getCollection("work");
const sortedWork = workItems.sort(
    (a, b) => (b.data.order || 0) - (a.data.order || 0),
);

function formatDate(date: Date | undefined) {
    if (!date) return "";
    return date.toLocaleDateString("en-US", {
        month: "short",
        year: "numeric",
    });
}

const mainWork = sortedWork.filter((w) => w.data.companyLogo);
const otherExperience = sortedWork.filter((w) => !w.data.companyLogo);

const renderedWork = await Promise.all(
    mainWork.map(async (item) => {
        const { Content } = await item.render();
        return { ...item, Content };
    }),
);
---

<Layout
    title="Work Experience - Muhamad Wahyudin"
    description="My professional journey and experience."
>
    <header class="mb-12">
        <h1
            class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-300 mb-4 tracking-tight"
        >
            Work Experience
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-300">
            My professional journey so far.
        </p>
    </header>

    <div class="space-y-8 mb-16">
        {
            renderedWork.map((item) => (
                <Card className="group bg-slate-50 dark:bg-slate-800 border-0 shadow-none">
                    <CardContent className="p-6 sm:p-8">
                        <div class="flex items-start gap-4 mb-6">
                            {item.data.companyLogo && (
                                <div class="w-16 h-16 bg-white dark:bg-slate-900 rounded-xl shadow-sm flex items-center justify-center shrink-0 overflow-hidden">
                                    <img
                                        src={item.data.companyLogo}
                                        alt={item.data.company}
                                        class="rounded-lg w-12 h-12 object-contain"
                                    />
                                </div>
                            )}
                            <div class="flex-1 min-w-0">
                                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                                    <div>
                                        <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">
                                            {item.data.position}
                                        </h2>
                                        <p class="text-slate-600 dark:text-slate-400 mt-1 mb-2">
                                            {item.data.company}
                                        </p>
                                    </div>
                                    <time class="text-sm text-slate-400 shrink-0 flex items-center gap-1">
                                        <Calendar className="w-3 h-3" />
                                        {item.data.startDate.getFullYear()} —{" "}
                                        {item.data.endDate
                                            ? item.data.endDate.getFullYear()
                                            : "Present"}
                                    </time>
                                </div>
                            </div>
                        </div>

                        <div class="prose prose-sm dark:prose-invert max-w-none text-slate-600 dark:text-slate-400 mb-6">
                            <item.Content />
                        </div>

                        <div class="flex flex-wrap items-center gap-3">
                            {item.data.companyWeb && (
                                <a
                                    href={item.data.companyWeb}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-slate-200 bg-white hover:bg-slate-100 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-950 dark:hover:bg-slate-800 dark:hover:text-slate-50 h-9 px-3"
                                >
                                    <Link className="w-5 h-5 mr-2" />
                                    Website
                                </a>
                            )}
                            {item.data.playstoreUrl && (
                                <a
                                    href={item.data.playstoreUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-slate-900 text-slate-50 hover:bg-slate-900/90 dark:bg-slate-50 dark:text-slate-900 dark:hover:bg-slate-50/90 h-9 px-3"
                                >
                                    <Play className="w-5 h-5 mr-2" />
                                    Play Store
                                </a>
                            )}
                        </div>
                    </CardContent>
                </Card>
            ))
        }
    </div>

    {
        otherExperience.length > 0 && (
            <section>
                <h2 class="text-2xl font-semibold text-slate-900 dark:text-slate-100 mb-8">
                    Other Experience
                </h2>
                <div class="relative">
                    <div class="absolute left-4 sm:left-8 top-2 bottom-2 w-px bg-slate-200 dark:bg-slate-700" />

                    <div class="space-y-8">
                        {otherExperience.map((item) => (
                            <article class="relative pl-12 sm:pl-20">
                                <div
                                    class:list={[
                                        "absolute left-2 sm:left-6 w-4 h-4 rounded-full border-4",
                                        item.data.current
                                            ? "bg-slate-900 dark:bg-slate-100 border-slate-900 dark:border-slate-100"
                                            : "bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-600",
                                    ]}
                                    style="top: 6px;"
                                />

                                <div class="pb-8 border-b border-slate-100 dark:border-slate-800 last:border-0">
                                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
                                        <div>
                                            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
                                                {item.data.position}
                                            </h3>
                                            <p class="text-slate-600 dark:text-slate-400">
                                                {item.data.company}
                                            </p>
                                        </div>
                                        <time class="text-sm text-slate-400 shrink-0 flex items-center gap-1">
                                            <Calendar className="w-3 h-3" />
                                            {formatDate(
                                                item.data.startDate,
                                            )} —{" "}
                                            {item.data.current
                                                ? "Present"
                                                : formatDate(item.data.endDate)}
                                        </time>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                </div>
            </section>
        )
    }
</Layout>
