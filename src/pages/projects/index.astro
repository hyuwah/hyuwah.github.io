---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectsList from "../../components/projects/ProjectsList";

const projects = await getCollection("projects");
const sortedProjects = projects.sort(
    (a, b) => (a.data.order || 0) - (b.data.order || 0),
);

const featuredProjects = sortedProjects.filter((p) => p.data.featured);
const otherProjects = sortedProjects.filter((p) => !p.data.featured);
---

<Layout
    title="Projects - Muhammad Wahyudin"
    description="A collection of projects I've worked on."
>
    <header class="mb-12">
        <h1
            class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-300 mb-4 tracking-tight"
        >
            Projects
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
            A collection of things I've built over the years.
        </p>
    </header>

    <ProjectsList
        client:load
        featuredProjects={featuredProjects}
        otherProjects={otherProjects}
    />
</Layout>
